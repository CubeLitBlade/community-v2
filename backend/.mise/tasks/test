#!/usr/bin/env bash
//MISE description="Run 'go test' to a microservice."

source "${BASH_SOURCE[0]%/*}/lib/modules.sh"

ALIAS=$1
shift || true
EXTRA_FLAGS=("$@")
BASE_FLAGS=("-cover")
ALL_FLAGS=("${BASE_FLAGS[@]}" "${EXTRA_FLAGS[@]}")

if [[ -n "$ALIAS" && -z "${MODULES_PATH[$ALIAS]}" ]]; then
    echo "Error: Unknown alias '$ALIAS'"
    echo "Available: ${MODULES_ALIASES[*]}"
    exit 1
fi

if [[ -n "$ALIAS" ]]; then
    TARGET_PATH="${MODULES_PATH[$ALIAS]}"
    echo "Testing module '$ALIAS' with flags:${ALL_FLAGS[*]}"
    mise exec -C "$TARGET_PATH" -- go test "${ALL_FLAGS[@]}" ./...
    exit $?
fi

echo "Testing all modules with flags: ${ALL_FLAGS[*]}"
for mod in "${!MODULES_PATH[@]}"; do
    echo "--- Testing $mod ---"
    mise exec -C "${MODULES_PATH[$mod]}" -- go test "${ALL_FLAGS[@]}" ./...
done
